{
  "expo": {
    "name": "Gurbani audio player",
    "slug": "gurbani-audio-player",
    "scheme": "gurbaniaudioplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-light.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./src/i18n/native-metadata/en.json",
      "pa": "./src/i18n/native-metadata/pa.json"
    },
    "runtimeVersion": "1.0.4",
    "updates": {
      "url": "https://updatesgurbaniaudioplayer.opensikhapps.com",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opensikhapps.gurbaniaudioplayer",
      "associatedDomains": [
        "applinks:gurbaniaudioplayer.opensikhapps.com"
      ],
      "usesIcloudStorage": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E4",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.opensikhapps.gurbaniaudioplayer",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "jasdeep-singh-malhotra",
          "project": "gurbaniaudioplayer"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-localization",
      "expo-asset",
      "@react-native-vector-icons/material-icons",
      "./plugins/with-android-notification-icon",
      "./plugins/with-ios-exclude-from-backup",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-light.png",
          "backgroundColor": "#F7F0E4",
          "dark": {
            "image": "./assets/icon-dark.png",
            "backgroundColor": "#0F1724"
          }
        }
      ],
      [
        "@kesha-antonov/react-native-background-downloader",
        {
          "skipMmkvDependency": true
        }
      ],
      "react-native-notify-kit",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f350048b-f2c9-4a14-9c67-65a9cbae34fb"
      },
      "googleWebClientId": "687386663876-8l7l063gc009embkou152a452cclebp1.apps.googleusercontent.com"
    },
    "owner": "cingh-jasdeep"
  }
}