+// PlayerConfig has no extra flags; JS packs icon + skipOnError + remotePrimary + httpOverflow here.
+private fun TrackPlayerCore.applyConfigToken(token: String) {
+    if (!token.contains(':')) {
+        NitroPlayerPlaybackService.notificationSmallIconResName = token
+        return
+    }
+    for (part in token.split(';')) {
+        val idx = part.indexOf(':')
+        if (idx < 0) continue
+        val key = part.substring(0, idx)
+        val value = part.substring(idx + 1)
+        when (key) {
+            "skipOnError" -> skipOnSourceError = value == "1"
+            "remotePrimary" -> remotePrimarySeek = value != "skip"
+            "httpOverflow" -> allowHttpOverflow = value != "0"
+            "icon" ->
+                if (value.isNotEmpty()) {
+                    NitroPlayerPlaybackService.notificationSmallIconResName = value
+                }
+        }
+    }
+}
