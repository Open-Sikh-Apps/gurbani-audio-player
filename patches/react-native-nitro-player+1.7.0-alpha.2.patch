+package com.margelo.nitro.nitroplayer.media
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import com.margelo.nitro.nitroplayer.core.NitroPlayerLogger
+
+/**
+ * API 33+ System UI sends sessionActivity as a single getActivity PendingIntent.
+ * This activity exists only to turn that tap into the VIEW URI Expo Router already handles.
+ */
+class SessionActivityTrampoline : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        NitroPlayerLogger.log("SessionActivityTrampoline") {
+            "media notification tap → ${NitroPlayerPlaybackService.SESSION_ACTIVITY_URI}"
+        }
+        val launch = packageManager.getLaunchIntentForPackage(packageName)
+        val view =
+            Intent(
+                Intent.ACTION_VIEW,
+                Uri.parse(NitroPlayerPlaybackService.SESSION_ACTIVITY_URI),
+            ).apply {
+                component = launch?.component
+                addCategory(Intent.CATEGORY_DEFAULT)
+                addCategory(Intent.CATEGORY_BROWSABLE)
+                addFlags(
+                    Intent.FLAG_ACTIVITY_NEW_TASK or
+                        Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                        Intent.FLAG_ACTIVITY_SINGLE_TOP,
+                )
+            }
+        startActivity(view)
+        finish()
+    }
+}
