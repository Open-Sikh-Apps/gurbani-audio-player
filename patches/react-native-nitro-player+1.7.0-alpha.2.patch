+private fun TrackPlayerCore.shouldClampHttpOverflow(index: Int): Boolean {
+    if (allowHttpOverflow) {
+        return false
+    }
+    val url = currentTracks.getOrNull(index)?.url ?: return false
+    return url.startsWith("http://", ignoreCase = true) ||
+        url.startsWith("https://", ignoreCase = true)
+}
+
+internal fun TrackPlayerCore.seekBackOverflowing() {
+    val delta = remoteSkipBackwardIntervalMs
+    val position = exo.currentPosition
+    if (position >= delta) {
+        isManuallySeeked = true
+        exo.seekTo(position - delta)
+        return
+    }
+    if (currentTrackIndex <= 0) {
+        isManuallySeeked = true
+        exo.seekTo(0)
+        return
+    }
+    val prevIndex = currentTrackIndex - 1
+    if (shouldClampHttpOverflow(prevIndex)) {
+        isManuallySeeked = true
+        exo.seekTo(0)
+        return
+    }
+    val remainder = delta - position
+    val prevDurationMs = (currentTracks.getOrNull(prevIndex)?.duration ?: 0.0) * 1000.0
+    playFromIndexInternal(prevIndex)
+    isManuallySeeked = true
+    exo.seekTo((prevDurationMs - remainder).coerceAtLeast(0.0).toLong())
+}
+
+internal fun TrackPlayerCore.seekForwardOverflowing() {
+    val delta = remoteSkipForwardIntervalMs
+    val position = exo.currentPosition
+    val duration = if (exo.duration > 0) exo.duration else 0L
+    if (duration <= 0L) {
+        isManuallySeeked = true
+        exo.seekTo(position + delta)
+        return
+    }
+    val remaining = duration - position
+    if (remaining > delta) {
+        isManuallySeeked = true
+        exo.seekTo(position + delta)
+        return
+    }
+    if (currentTrackIndex >= currentTracks.size - 1) {
+        isManuallySeeked = true
+        exo.seekTo(duration)
+        return
+    }
+    if (shouldClampHttpOverflow(currentTrackIndex + 1)) {
+        isManuallySeeked = true
+        exo.seekTo(duration)
+        return
+    }
+    val leftover = delta - remaining
+    playFromIndexInternal(currentTrackIndex + 1)
+    isManuallySeeked = true
+    exo.seekTo(leftover.coerceAtLeast(0L))
+}
