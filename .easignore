# If this file exists, EAS uses it *instead of* .gitignore for the build archive
# (`eas build --local` unpacks that archive in a temp dir). Copy gitignore here,
# then omit anything the binary must have on disk.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Play upload keystore — CLI reads these from the project root, not the archive.
credentials.json
credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Metro-only. Preview/production URLs come from eas.json env, not .env.
.env
.env*.local
.env.sentry-build-plugin

# typescript
*.tsbuildinfo

# generated native folders (CNG prebuild)
/ios
/android

# local EAS artifacts
build-*.apk
build-*.aab

# expo-updates export used by scripts/publish-update.ts
dist-update/

# local khajana tagging (mutagen)
.venv-khajana/

.wrangler

temp

# Do not ignore google-services.json / GoogleService-Info.plist (or the -dev
# copies). They are gitignored so they stay off GitHub; the archive still needs
# them for the Firebase / Google Sign-in plugins.
