# Cloudflare Pages origin with no trailing slash.
# Copy to `.env` and set after the first Direct Upload.
# `expo start` / `expo run` load this file. `eas build --local` does not —
# preview APK and Play AAB take EXPO_PUBLIC_* from eas.json `build.*.env`.
EXPO_PUBLIC_CATALOGUE_BASE_URL=

# no trailing slash. Catalogue JSON stores /audio/… and /images/….
EXPO_PUBLIC_MEDIA_BASE_URL=

# 1 / true / yes = bundled src/catalogue/mock-catalogue.json only (no Pages, no disk cache).
# Unset, 0, or false to use EXPO_PUBLIC_CATALOGUE_BASE_URL. Independent of __DEV__.
# Restart Metro after changing (EXPO_PUBLIC_* is inlined at bundle time).
EXPO_PUBLIC_USE_MOCK_CATALOGUE=0

# Sentry DSN. Leave empty to disable JS init. Native still links; events need a DSN.
# eas build --local does not load .env — set the same key on eas.json build profile env.
EXPO_PUBLIC_SENTRY_DSN=

# Source-map upload (sentry-cli during release Gradle). Not EXPO_PUBLIC_*.
# Put the org auth token in `.env.sentry-build-plugin` (gitignored, packed by
# EAS). Create the token at sentry.io → Settings → Auth Tokens (releases).
# SENTRY_AUTH_TOKEN=

# Web client ID from Firebase Authentication → Google. Used by a later Cloud sync OTA.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=